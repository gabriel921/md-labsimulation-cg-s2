; INPUT FILE 

; GENERAL INPUT FLAGS
title                  = aS_2n0a_Sirah2
cpp                    = /usr/bin/cpp
define                 = -DPOSRES

; RUN FLAGS
integrator             = md
dt                     = 0.020
nsteps                 = 250000
pbc                    = xyz

; NON-BONDED INTERACTIONS FLAGS
ns_type                = grid
nstlist                = 10
rlist                  = 1.2
coulombtype            = PME
rcoulomb               = 1.2
vdwtype                = Cut-off
rvdw                   = 1.2

optimize_fft           = yes
fourierspacing         = 0.2

; DISPERSION CORRECTION
DispCorr               = EnerPres

; TEMPERATURE COUPLING FLAGS
tcoupl                 = V-rescale
tc-grps                = Protein SIRAH-Solvent
tau_t                  = 1.0 1.0
ref_t                  = 310 310 

; INITIAL STEP VELOCITIES FLAGS
gen_vel                = yes
gen_temp               = 310
gen_seed               = -1

; PRESSURE COUPLING FLAGS
Pcoupl                 = no

; CONSTRAINTS
constraint_algorithm  = lincs

; DISTANCE RESTRAINTS
; None (see manual)

; OUTPUT FLAGS
nstxout                = 0
nstvout                = 0
nstlog                 = 1000
nstenergy              = 100
nstxout-compressed	   = 100
energygrps		         = Protein WT4 NaW ClW
