; INPUT FILE 

; GENERAL INPUT FLAGS
title                  = MD_Prd
cpp                    = /usr/bin/cpp
; define                 = 

; RUN FLAGS
integrator             = md
dt                     = 0.020
nsteps                 = 50000000
pbc                    = xyz

; NON-BONDED INTERACTIONS FLAGS
ns_type                = grid
nstlist                = 25
rlist                  = 1.2
coulombtype            = PME
rcoulomb               = 1.2
vdwtype                = Cut-off
rvdw                   = 1.2

; GPU
cutoff-scheme          = Verlet
verlet-buffer-drift    =-1

optimize_fft           = yes
fourierspacing         = 0.25

; DISPERSION CORRECTION
DispCorr               = EnerPres          

; TEMPERATURE COUPLING FLAGS
tcoupl                 = V-rescale
tc-grps                = Protein SIRAH-Solvent
tau_t                  = 2.0 2.0
ref_t                  = 310 310 

; INITIAL STEP VELOCITIES FLAGS
gen_vel                = no
; gen_temp               = 310
; gen_seed               = -1

; PRESSURE COUPLING FLAGS
Pcoupl                 = Parrinello-Rahman
pcoupltype             = isotropic
tau_p                  = 10.0
compressibility        = 4.5e-5
ref_p                  = 1.0
refcoord-scaling       = com

; CONSTRAINTS
; continuation          = yes       
; constraint_algorithm  = lincs      
; constraints           = h-bonds   
; lincs_iter            = 2         
; lincs_order           = 4         

; OUTPUT FLAGS
nstxout                = 0
nstvout                = 0
nstlog                 = 1000
nstenergy              = 100
compressed-x-grps      = Protein
nstxout-compressed     = 100              
compressed-x-precision = 10000
energygrps		 = 
